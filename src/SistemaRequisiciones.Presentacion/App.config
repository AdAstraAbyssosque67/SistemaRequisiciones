<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!-- Cambia Data Source si usas otra instancia (por ejemplo .\SQLEXPRESS). -->
    <add name="SistemaRequisiciones"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=SistemaRequisiciones;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Tasa de impuesto inicial (18 %). Es un valor de ejemplo configurable, no una tasa legal asumida. -->
    <add key="TasaImpuesto" value="0.18" />
  </appSettings>
</configuration>
